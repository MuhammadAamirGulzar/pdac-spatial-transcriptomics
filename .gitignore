# ── Secrets ───────────────────────────────────────────────────────────────────
keys.txt

# ── Dataset (hosted on Kaggle — not stored here) ──────────────────────────────
dataset/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Large binary / model files ────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.npy
*.h5
*.h5ad
*.pkl
*.zip

# ── Intermediate training artifacts (per-fold, not needed to reproduce results) ──
Outputs/Plots/
Outputs/bridge_ckpts/

# Stage 2: exclude per-fold tensors but keep final trained models
# (negation overrides the *.pt rule above for final_model files only)
!Outputs/stage2/**/final_model.pt
!Outputs/stage2/**/final_model_A.pt
!Outputs/stage2/**/final_model_B.pt

# ── Auto-generated caches (derived from dataset, reproducible) ────────────────
docs/presentation/_tissue_cache/
presentation/_tissue_cache/

# ── Internal build artifacts ──────────────────────────────────────────────────
docs/presentation/_template_dump.txt

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.claude/
.DS_Store
Thumbs.db
